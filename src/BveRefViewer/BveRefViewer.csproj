<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BveRefViewer</AssemblyName>
    <RootNamespace>BveRefViewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>BVE 参照ファイルビューア</Product>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 外部ライブラリの名前の一覧(利用者が書き足せるよう、exeと同じフォルダに置く) -->
    <None Include="libraries.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
